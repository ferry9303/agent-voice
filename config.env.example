# 语音播报配置。被 speak.sh 直接 source，改完立即生效，不用重启任何东西。
#
# 全部用 ${VAR:-默认} 写法：这样命令行上临时指定的环境变量优先级更高。
# 写成 VAR=值 会把 `AGENT_VOICE=0 某命令` 这种临时覆盖顶掉。

# 总开关：0=关掉朗读
AGENT_VOICE="${AGENT_VOICE:-1}"

# 引擎：auto(Kokoro 不可用时自动退回 say) | kokoro | say
AGENT_VOICE_ENGINE="${AGENT_VOICE_ENGINE:-auto}"

# Kokoro 音色。跑 audition.sh 试听，audition.sh -l 列出全部 103 个
AGENT_VOICE_KOKORO_VOICE="${AGENT_VOICE_KOKORO_VOICE:-zf_017}"
AGENT_VOICE_SPEED="${AGENT_VOICE_SPEED:-1.0}"

# 断句：句末停顿的切分粒度
#   sentence（默认）只在句号/问号/感叹号处切开合成，停顿层次稳定
#   clause         连逗号也切，最规整但模型对短片段会放慢语速，长文听着发拖
#   off            整段一次合成，最快，但停顿时长完全由模型决定、忽长忽短
AGENT_VOICE_CHUNK="${AGENT_VOICE_CHUNK:-sentence}"

# 停顿时长的整体倍率。嫌顿得不够明显调到 1.3，嫌拖沓调到 0.7
AGENT_VOICE_PAUSE_SCALE="${AGENT_VOICE_PAUSE_SCALE:-1.0}"

# 播报长度：想更啰嗦就调大，只想听一句就调到 60 左右
AGENT_VOICE_MAX_CHARS="${AGENT_VOICE_MAX_CHARS:-200}"
AGENT_VOICE_MAX_SENTENCES="${AGENT_VOICE_MAX_SENTENCES:-6}"

# 摘要方式：
#   first = 取回复开头几句，0 延迟、不花钱（推荐）
#   llm   = 调 claude haiku 做真摘要，约 10s 延迟且消耗额度
AGENT_VOICE_MODE="${AGENT_VOICE_MODE:-first}"

# 等本轮最终回复落盘的秒数。Stop hook 触发时最终回复常常还没写完，
# 调成 0 会退回「念上一条」的老毛病。
AGENT_VOICE_WAIT="${AGENT_VOICE_WAIT:-6}"

# 以下仅在退回 say 引擎时生效
AGENT_VOICE_SAY_VOICE="${AGENT_VOICE_SAY_VOICE:-Tingting}"
AGENT_VOICE_SAY_RATE="${AGENT_VOICE_SAY_RATE:-172}"
