# 语音播报配置。被 speak.sh 直接 source，改完立即生效，不用重启任何东西。
#
# 全部用 ${VAR:-默认} 写法：这样命令行上临时指定的环境变量优先级更高。
# 写成 VAR=值 会把 `WINCORP_TTS=0 某命令` 这种临时覆盖顶掉。

# 总开关：0=关掉朗读
WINCORP_TTS="${WINCORP_TTS:-1}"

# 引擎：auto(Kokoro 不可用时自动退回 say) | kokoro | say
WINCORP_TTS_ENGINE="${WINCORP_TTS_ENGINE:-auto}"

# Kokoro 音色。跑 audition.sh 试听，audition.sh -l 列出全部 103 个
WINCORP_TTS_KOKORO_VOICE="${WINCORP_TTS_KOKORO_VOICE:-zf_017}"
WINCORP_TTS_SPEED="${WINCORP_TTS_SPEED:-1.0}"

# 播报长度：想更啰嗦就调大，只想听一句就调到 60 左右
WINCORP_TTS_MAX_CHARS="${WINCORP_TTS_MAX_CHARS:-200}"
WINCORP_TTS_MAX_SENTENCES="${WINCORP_TTS_MAX_SENTENCES:-6}"

# 摘要方式：
#   first = 取回复开头几句，0 延迟、不花钱（推荐）
#   llm   = 调 claude haiku 做真摘要，约 10s 延迟且消耗额度
WINCORP_TTS_MODE="${WINCORP_TTS_MODE:-first}"

# 等本轮最终回复落盘的秒数。Stop hook 触发时最终回复常常还没写完，
# 调成 0 会退回「念上一条」的老毛病。
WINCORP_TTS_WAIT="${WINCORP_TTS_WAIT:-6}"

# 以下仅在退回 say 引擎时生效
WINCORP_TTS_VOICE="${WINCORP_TTS_VOICE:-Tingting}"
WINCORP_TTS_RATE="${WINCORP_TTS_RATE:-172}"
